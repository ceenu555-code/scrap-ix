# SCRAPIX Environment Variables Configuration
# Copy this file to .env.local to configure credentials

# Brand & System Settings
NEXT_PUBLIC_APP_NAME="SCRAPIX"
NEXT_PUBLIC_APP_TAGLINE="Your Scrap. Our Responsibility."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Business API Placeholder
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
WHATSAPP_API_KEY=""

# SMS OTP Provider (e.g. MSG91, Twilio, Fast2SMS)
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="SCRAPM"

# Payment Gateway (e.g. Razorpay, Cashfree)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google Maps Platform API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Database Connection (e.g. Supabase, PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/scrapix?schema=public"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
